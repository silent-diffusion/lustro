<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded in lustro-scan-helper.exe by build.rs. Deliberately has no <dependency>
  elements. Having an embedded manifest at all makes Windows ignore a planted
  lustro-scan-helper.exe.local folder and an external lustro-scan-helper.exe.manifest file.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Lustro.ScanHelper" version="1.0.0.0" processorArchitecture="*"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
