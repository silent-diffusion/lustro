{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call Lustro's own commands and listen to its events. Nothing else: no shell, fs, http or opener access, and no remote URLs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-platform",
    "allow-list-volumes",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-root",
    "allow-children",
    "allow-node",
    "allow-path-to",
    "allow-subtree",
    "allow-top",
    "allow-search",
    "allow-space-breakdown",
    "allow-cloud-summary",
    "allow-list-snapshots",
    "allow-diff",
    "allow-suggestions",
    "allow-apply-cleanup",
    "allow-undo-log",
    "allow-undo",
    "allow-reveal",
    "allow-open-setting",
    "allow-get-settings",
    "allow-set-settings",
    "allow-clear-history",
    "allow-pick-folder",
    "allow-app-version",
    "allow-check-for-update",
    "allow-install-update",
    "allow-current-release-notes",
    "allow-restart-to-update",
    "allow-skip-version",
    "allow-update-status",
    "allow-build-info"
  ]
}
